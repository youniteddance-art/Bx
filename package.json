{
  "name": "brix-umrechner",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-Umrechner für Brix, Dichte, Extrakt und Oechsle",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win portable --x64",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:assets": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.0",
    "electron": "^43.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dance.younited.brixumrechner",
    "productName": "Brix Umrechner",
    "artifactName": "Brix-Umrechner-Windows.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "web/**/*"
    ],
    "win": {
      "icon": "assets/icon-only.png",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
